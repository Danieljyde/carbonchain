# ── Node / JavaScript ─────────────────────────────────────────────────────────
node_modules/
dist/
.angular/
.nest/

# Package managers
.npm/
.yarn/
yarn.lock
pnpm-lock.yaml
*.tgz
*.tar.gz

# ── Rust / Soroban ────────────────────────────────────────────────────────────
target/

# Root Cargo.lock is ignored; the contracts workspace lockfile is kept.
Cargo.lock
!contracts/Cargo.lock

# Compiled WASM artifacts
*.wasm

# ── Soroban CLI state and deployment artefacts ───────────────────────────────
.soroban/
.stellar/
contract-ids.testnet.json
scripts/contract-ids.testnet.json
contract-ids.*.json

# ── Test artifacts — auto-generated, must not be committed ──────────────────
# Soroban snapshot tests (generated by soroban-sdk test framework)
test_snapshots/
**/test_snapshots/

# Coverage and test reports
coverage/
coverage-final.json
__snapshots__/
*.snap
junit.xml
test-results/
.nyc_output/
lcov.info
*.lcov
jest-coverage/
jasmine-results/
karma-test-results.xml
browser_test_results/

# Test runner caches
.vitest-cache/
.jest-cache/
.jest_cache/
.karma/

# Playwright / Cypress artifacts
playwright-report/
cypress/screenshots/
cypress/videos/
cypress/downloads/

# ── Build artifacts ───────────────────────────────────────────────────────────
build/
*.js.map
*.d.ts.map
*.tsbuildinfo

# shared/ package compiled output (source is index.ts)
shared/index.js
shared/index.d.ts

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Kiro CLI ──────────────────────────────────────────────────────────────────
# Ignore auto-generated Kiro agent files but keep committed specs
.kiro/agents/

# ── Runtime data ──────────────────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Profiling ─────────────────────────────────────────────────────────────────
*.heapsnapshot
*.cpuprofile

# ── Temporary and editor backup files ────────────────────────────────────────
*.tmp
*.bak
*.orig
*.rej
*~

# ── Docker Compose local overrides ───────────────────────────────────────────
docker-compose.override.yml
